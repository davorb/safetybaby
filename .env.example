# babymon settings. Copy to .env in the working directory, or export as environment
# variables. Nested groups use a double underscore: BABYMON_<GROUP>__<FIELD>.
# Optional groups (vision, pushover) are all-or-nothing: set every required field of a
# group or none of it. A half-set group stops startup with a message naming the gap.

# ---- camera (required) ----
BABYMON_CAMERA__USER=
BABYMON_CAMERA__PASSWORD=
# BABYMON_CAMERA__HOST=192.168.68.75
# BABYMON_CAMERA__PORT=554
# BABYMON_CAMERA__STREAM_PATH=/stream2
# Seconds without a frame before ffmpeg is killed and restarted.
# BABYMON_CAMERA__STALL_S=10
# Motion region as x,y,w,h in 640x360 frame coordinates. Unset = whole frame.
# BABYMON_CAMERA__MOTION_ROI=120,40,400,280
# Per-pixel difference below this counts as sensor noise, 0..255.
# BABYMON_CAMERA__MOTION_NOISE_THRESHOLD=12

# ---- vision (optional; without it vision checks are disabled) ----
# ANTHROPIC_API_KEY is accepted as an alias for BABYMON_VISION__API_KEY.
# BABYMON_VISION__API_KEY=
# BABYMON_VISION__MODEL=claude-haiku-5-5
# Stills are downscaled to this width before upload; image cost scales with pixels.
# BABYMON_VISION__API_FRAME_WIDTH=640

# ---- pushover (optional; without it alerts are logged, not delivered) ----
# BABYMON_PUSHOVER__APP_TOKEN=
# Comma-separated user keys, one per phone.
# BABYMON_PUSHOVER__USER_KEYS=
# BABYMON_PUSHOVER__EMERGENCY_RETRY_S=30
# BABYMON_PUSHOVER__EMERGENCY_EXPIRE_S=600

# ---- paths and ports ----
# BABYMON_DATA_DIR=/data
# BABYMON_YAMNET_PATH=/models/yamnet.onnx
# BABYMON_HTTP_PORT=8080

# ---- tuning (every threshold the decision core reads) ----
# Consecutive confident vision checks before FACE_COVERED or ON_STOMACH fires.
# BABYMON_TUNING__UNSAFE_STREAK=2
# BABYMON_TUNING__HEAD_LEFT_ALERT_S=120
# BABYMON_TUNING__CRYING_ALERT_S=60
# BABYMON_TUNING__CAMERA_OFFLINE_ALERT_S=60
# Vision readings below this confidence neither extend nor reset a streak.
# BABYMON_TUNING__MIN_CONFIDENCE=0.5
# Periodic check interval when motion was seen since the last check.
# BABYMON_TUNING__VISION_PERIOD_S=60
# Periodic check interval on a still scene.
# BABYMON_TUNING__VISION_PERIOD_QUIET_S=900
# Check interval while a dangerous streak is pending confirmation.
# BABYMON_TUNING__VISION_CONFIRM_S=15
# Minimum gap before a settled-after-motion check.
# BABYMON_TUNING__VISION_MIN_SPACING_S=10
# An in-flight vision request older than this counts as lost.
# BABYMON_TUNING__VISION_TIMEOUT_S=45
# An observation older than this no longer feeds the sleep machine.
# BABYMON_TUNING__OBSERVATION_FRESH_S=90
# Motion level (fraction of changed pixels) for the MOVING and ACTIVE signals.
# BABYMON_TUNING__MOTION_MOVING=0.02
# BABYMON_TUNING__MOTION_ACTIVE=0.08
# BABYMON_TUNING__CRY_PROBABILITY=0.6
# Seconds between repeat notifications of the same alert kind.
# BABYMON_TUNING__ALERT_COOLDOWN_S=600
